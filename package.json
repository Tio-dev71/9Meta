{
  "name": "9meta",
  "version": "2.5.56",
  "description": "Nhà Yến Zalo - Quản lý nhiều tài khoản, người dùng và nhóm Zalo trên Desktop.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:electron-unfriend": "electron test/electron-unfriend-detached-smoke.js",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.nhayen.zalo",
    "productName": "Nhà Yến Zalo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "update-notice.html",
      "custom_style.css",
      "modules/**/*.js",
      "icon.ico",
      "icon.png",
      "brand-logo.png",
      "assets/fonts/Quicksand-VariableFont_wght.ttf",
      "assets/default-quick-replies/**/*",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "dmg": {
      "artifactName": "Nha-Yen-Zalo-Setup-${version}-${arch}.${ext}",
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Nhà Yến Zalo",
      "artifactName": "Nha-Yen-Zalo-Setup-${version}.${ext}",
      "include": "build/installer-access-code.nsh"
    },
    "releaseInfo": {
      "releaseNotes": "Nhà Yến Zalo v2.5.56:\n- Sửa lỗi không lưu được tài khoản trên một số máy nhân viên và bắt buộc mở khóa dữ liệu đúng trạng thái.\n- Phân biệt rõ lỗi khóa dữ liệu, lỗi quyền ghi Windows và yêu cầu không hợp lệ.\n- Khôi phục dữ liệu còn thiếu từ thư mục Nhayenzalo về 9meta mà không ghi đè dữ liệu hiện có.\n- Tích hợp sẵn thư viện video và đầy đủ bộ Tin nhắn nhanh dùng trigger dấu \\.\n- Giữ nguyên các sửa lỗi tạo đơn Pancake, bộ cài đặt và logo ứng dụng."
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thaophamce",
        "repo": "nhayen-zalo-updates"
      }
    ],
    "extraResources": [
      {
        "from": "assets/default-videos",
        "to": "default-videos",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "author": "Tiodev71",
  "license": "MIT",
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "electron-updater": "^6.8.3",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "allowScripts": {
    "electron@29.4.6": true
  }
}
