{
  "name": "9meta",
"version": "2.5.60-test",
  "description": "Nhà Yến Zalo - Quản lý nhiều tài khoản, người dùng và nhóm Zalo trên Desktop.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:electron-unfriend": "electron test/electron-unfriend-detached-smoke.js",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.nhayen.zalo",
    "productName": "Nhà Yến Zalo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "update-notice.html",
      "custom_style.css",
      "modules/**/*.js",
      "icon.ico",
      "icon.png",
      "brand-logo.png",
      "assets/fonts/Quicksand-VariableFont_wght.ttf",
      "assets/default-quick-replies/**/*",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "dmg": {
      "artifactName": "Nha-Yen-Zalo-Setup-${version}-${arch}.${ext}",
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Nhà Yến Zalo",
      "artifactName": "Nha-Yen-Zalo-Setup-${version}.${ext}",
      "include": "build/installer-access-code.nsh"
    },
    "releaseInfo": {
"releaseNotes": "Nhà Yến Zalo v2.5.60:\n- Quét nhóm Zalo hoạt động lại: bộ quét viết lại theo kiểu Quét người dùng, thử nhiều tên manager và đọc dữ liệu Zalo tự tải về nên không còn báo \"Không tương thích\" hay đọc 0 nhóm.\n- Nút Chèn vào ô soạn tin ở tab Báo giá giữ đúng xuống dòng và Enter gửi được.\n- Rời nhóm hàng loạt không còn báo thiếu groupManager.\n- Thêm giới hạn chờ cho các lệnh Zalo treo."
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thaophamce",
        "repo": "nhayen-zalo-updates"
      }
    ],
    "extraResources": [
      {
        "from": "assets/default-videos",
        "to": "default-videos",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "author": "Tiodev71",
  "license": "MIT",
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "electron-updater": "^6.8.3",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "allowScripts": {
    "electron@29.4.6": true
  }
}
